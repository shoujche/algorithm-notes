---
// FastAPI 章节已迁到「Python 框架」板块；保留旧地址，静态跳转到新页面。
import { withBase } from '../../lib/url';

const target = withBase('/framework/fastapi');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>FastAPI 工程 · 已迁移</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>本章已迁移到 <a href={target}>Python 框架 / FastAPI 工程</a>。</p>
    <script is:inline define:vars={{ target }}>location.replace(target + location.hash);</script>
  </body>
</html>
