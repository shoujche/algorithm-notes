---
import BaseLayout from '../layouts/BaseLayout.astro';
import { agentChapters, algoChapters, categoryConfig, pythonChapters } from '../data/topics';
import { withBase } from '../lib/url';
---
<BaseLayout title="算法、Python 与 Agent 学习手记 · Interview Notes">
  <div class="home-wrap">
    <div class="hero">
      <span class="eyebrow">算法、Python 与 Agent 学习手记 · Interview Notes</span>
      <h2>图解<em>算法</em> · 深入 <em>Python</em> · 构建 <em>Agent</em></h2>
      <p>从零记录数据结构与算法、Python 工程和 Agent 系统的学习：用分步动画拆解经典题目，也梳理语言机制、并发、工具调用、沙盒与审批流程。</p>
      <div class="meta">
        <div><span class="n">{algoChapters.length}</span><span class="l">Algorithms</span></div>
        <div><span class="n">{pythonChapters.length}</span><span class="l">Python</span></div>
        <div><span class="n">{agentChapters.length}</span><span class="l">Agent</span></div>
        <div><span class="n">动画</span><span class="l">Visual</span></div>
        <div><span class="n">开源</span><span class="l">Open Source</span></div>
      </div>
    </div>

    {categoryConfig.map((g) => (
      <section id={g.key} class="cat-block">
        <h4 class="sub">{g.label.cn} · {g.label.en}</h4>
        <div class="topic-grid">
          {g.chapters.map((c) => (
            c.ready ? (
              <a class="topic-card" href={withBase(`${g.routePrefix}/${c.slug}`)}>
                <span class="tnum">CH.{c.num}</span>
                <h3>{c.cn}</h3>
                <span class="ten">{c.en}</span>
                <p>{c.summary}</p>
                <div class="go">阅读章节 →</div>
              </a>
            ) : (
              <div class="topic-card soon">
                <span class="tnum">CH.{c.num}</span>
                <h3>{c.cn}</h3>
                <span class="ten">{c.en}</span>
                <p>{c.summary}</p>
                <div class="go"><span class="badge-soon">规划中 Soon</span></div>
              </div>
            )
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .home-wrap { max-width: 1180px; margin: 0 auto; padding: 34px 30px; }
  .cat-block { margin-top: 8px; scroll-margin-top: 88px; }
  .cat-block + .cat-block { margin-top: 40px; }
</style>
