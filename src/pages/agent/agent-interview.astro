  .chapter-link, .source-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .source-note {
    margin: 8px 0 50px; padding-top: 18px; border-top: 1px solid var(--line);
    color: var(--muted); font-size: 12.5px;
  }
