---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import LcBadge from '../../components/LcBadge.astro';
import Idea from '../../components/Idea.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Interview from '../../components/Interview.astro';
import { chapters } from '../../data/topics';
import {
  CODE_DIR,
  approveWrite,
  filesystemNotes,
  memoryStore,
  pathPermissions,
  subagentTask,
} from '../../data/deepagents-code';
import { ghBlob } from '../../lib/github';
import { withBase } from '../../lib/url';

const chapter = chapters.find((item) => item.slug === 'deepagents')!;
const src = (file: string) => ghBlob(`${CODE_DIR}/${file}`);
const a01 = withBase('/agent/react-agent-loop');
const a06 = withBase('/agent/langgraph');
---
<BaseLayout title="Deep Agents 核心用法">
  <div class="layout">
    <Sidebar chapterCn={chapter.cn} chapterEn={chapter.en} currentSlug={chapter.slug} sections={chapter.sections} />
    <main>
      <div class="hero">
        <span class="eyebrow">Agent / {chapter.num} · Deep Agents</span>
        <h2>一套默认能力，跑在<em>同一张 LangGraph</em>上</h2>
        <p><kbd>create_deep_agent</kbd> 返回编译好的图。它在 LangChain 的 agent 上放进虚拟文件系统、<kbd>task</kbd> 子代理、长对话摘要，以及写文件前的人工确认。循环本身仍是 <a class="chapter-link" href={a01}>A01</a> 的工具调用；暂停和 <kbd>thread_id</kbd> 的语义见 <a class="chapter-link" href={a06}>A06 LangGraph</a>。下面的模型按脚本回复，安装 <kbd>deepagents</kbd> 0.7 即可，不需要 API key。在 <kbd>src/code/agent/deepagents</kbd> 目录下运行对应文件。</p>
        <div class="meta">
          <div><span class="n">06</span><span class="l">Topics</span></div>
          <div><span class="n">StateBackend</span><span class="l">当前线程</span></div>
          <div><span class="n">task</span><span class="l">子代理</span></div>
          <div><span class="n">不调模型</span><span class="l">可本地跑</span></div>
        </div>
      </div>

      <section class="article" id="harness">
        <div class="art-head"><span class="num">01</span><LcBadge kind="base" text="基础 · Harness" /></div>
        <h3>默认带上的工具</h3>
        <p class="lead">0.7.26 里，主代理一创建就有这些文件系统工具，外加 <kbd>task</kbd>。待办清单要自己加 <kbd>TodoListMiddleware</kbd>。<kbd>execute</kbd> 只在后端支持沙盒时出现，默认的 <kbd>StateBackend</kbd> 不提供它。</p>
        <table class="cmp">
          <thead>
            <tr><th></th><th>Deep Agents</th><th>自己接 LangChain</th><th>自己画 LangGraph</th></tr>
          </thead>
          <tbody>
            <tr><td>入口</td><td><kbd>create_deep_agent</kbd></td><td><kbd>create_agent</kbd> 加自己的 tools</td><td><kbd>StateGraph</kbd></td></tr>
            <tr><td>文件</td><td>ls、read、write、edit、delete、glob、grep</td><td>自己实现</td><td>自己实现</td></tr>
            <tr><td>分工</td><td><kbd>task</kbd> 把一段描述交给子代理</td><td>自己包一层</td><td>子图</td></tr>
            <tr><td>暂停</td><td><kbd>interrupt_on</kbd> 加上 checkpointer</td><td><kbd>HumanInTheLoopMiddleware</kbd></td><td>节点里 <kbd>interrupt()</kbd></td></tr>
            <tr><td>运行时</td><td>编译好的 LangGraph</td><td>编译好的 LangGraph</td><td>你编译的图</td></tr>
          </tbody>
        </table>
        <Idea>
          <ol class="steps">
            <li>虚拟路径以 <kbd>/</kbd> 开头，例如 <kbd>/notes/plan.md</kbd>。这是代理状态里的文件，不是本机磁盘。</li>
            <li>结果里有 <kbd>messages</kbd> 和 <kbd>files</kbd>。<kbd>files</kbd> 是当前线程 <kbd>StateBackend</kbd> 上的路径。</li>
            <li>规划工具 <kbd>write_todos</kbd> 从 0.7 起改为显式加入 middleware。</li>
          </ol>
        </Idea>
      </section>

      <section class="article" id="files">
        <div class="art-head"><span class="num">02</span><LcBadge kind="mid" text="核心 · Filesystem" /></div>
        <h3>写进当前线程，再读出来</h3>
        <p class="lead"><kbd>Scripted</kbd> 按列表弹出下一步：先 <kbd>write_file</kbd>，再 <kbd>read_file</kbd>，最后一句普通回复。工具消息会写明 <kbd>Updated file /notes/plan.md</kbd>，读回的正文里有 <kbd>ship it</kbd>。</p>
        <CodeBlock code={filesystemNotes} lang="python" file="filesystem_notes.py" src={src('filesystem_notes.py')} />
        <p class="cue"><span class="t">记忆提示</span>换一条 <kbd>thread_id</kbd> 之后，这份 <kbd>/notes/plan.md</kbd> 不在新线程的 <kbd>files</kbd> 里。要跨线程，把路径挂到 Store。</p>
      </section>

      <section class="article" id="permissions">
        <div class="art-head"><span class="num">03</span><LcBadge kind="mid" text="核心 · Permission" /></div>
        <h3>第一条命中的规则生效</h3>
        <p class="lead"><kbd>FilesystemPermission</kbd> 是 dataclass，字段是 <kbd>operations</kbd>、<kbd>paths</kbd>、<kbd>mode</kbd>。模式可以是 <kbd>allow</kbd>、<kbd>deny</kbd>、<kbd>interrupt</kbd>。没有命中的路径按允许处理，所以收紧写入时把拒绝规则放在前面。</p>
        <CodeBlock code={pathPermissions} lang="python" file="path_permissions.py" src={src('path_permissions.py')} />
        <p class="cue"><span class="t">记忆提示</span><kbd>/private/**</kbd> 能配到 <kbd>/private/draft.md</kbd>。文件名以点开头时，把点写进规则，例如 <kbd>/private/**/.env</kbd>。这些规则管文件系统工具；沙盒里的 <kbd>execute</kbd> 另算。</p>
        <Interview q="子代理会沿用父代理的权限吗？">
          <p>子代理规格里自己写了 <kbd>permissions</kbd> 时，用它的那一份。没写就沿用创建主代理时传入的规则。</p>
        </Interview>
      </section>

      <section class="article" id="subagent">
        <div class="art-head"><span class="num">04</span><LcBadge kind="mid" text="核心 · Subagent" /></div>
        <h3>父代理只看见最终结论</h3>
        <p class="lead"><kbd>task</kbd> 的参数是 <kbd>description</kbd> 和 <kbd>subagent_type</kbd>。默认的子代理上下文是隔离的：它收到的是这一段描述，中间的工具来回留在它自己的消息里。交回父代理的 <kbd>ToolMessage</kbd> 是最后一句有正文的回复。它改过的文件会合并进父状态。</p>
        <CodeBlock code={subagentTask} lang="python" file="subagent_task.py" src={src('subagent_task.py')} />
        <p class="cue"><span class="t">记忆提示</span>父消息里有 <kbd>verdict: ship</kbd>，没有草稿正文。文件列表里仍有 <kbd>/scratch/notes.md</kbd>。规格里 <kbd>mode: "fork"</kbd> 会改成继承父对话，这一节用的是默认隔离。</p>
      </section>

      <section class="article" id="memory">
        <div class="art-head"><span class="num">05</span><LcBadge kind="mid" text="记忆 · Store" /></div>
        <h3>一条路径进 Store，其余留在线程里</h3>
        <p class="lead"><kbd>CompositeBackend</kbd> 按前缀分流。<kbd>/memories/</kbd> 交给 <kbd>StoreBackend</kbd>，namespace 由运行时生成。<kbd>/notes/scratch.md</kbd> 走默认的 <kbd>StateBackend</kbd>，只属于线程 A。线程 B 能读到记忆文件，读草稿会得到 not found。</p>
        <CodeBlock code={memoryStore} lang="python" file="memory_store.py" src={src('memory_store.py')} />
        <p class="cue"><span class="t">记忆提示</span>线程 A 的 <kbd>files</kbd> 里看得到草稿。记忆文件在 Store 里，所以不出现在这条状态的 <kbd>files</kbd> 列表中，换线程后仍能 <kbd>read_file</kbd>。</p>
      </section>

      <section class="article" id="approval">
        <div class="art-head"><span class="num">06</span><LcBadge kind="mid" text="审批 · interrupt" /></div>
        <h3>写文件先停住，批准后再落盘</h3>
        <p class="lead"><kbd>interrupt_on</kbd> 把 <kbd>write_file</kbd> 标成需要批准，并且要有 checkpointer。第一次 <kbd>invoke</kbd> 的 <kbd>__interrupt__</kbd> 里列出工具名和参数，此时 <kbd>files</kbd> 还没有这份笔记。用同一个 <kbd>thread_id</kbd> 送入 <kbd>Command</kbd>，<kbd>resume</kbd> 里的 decisions 写 <kbd>type: approve</kbd>，工具消息才变成 Updated file。</p>
        <CodeBlock code={approveWrite} lang="python" file="approve_write.py" src={src('approve_write.py')} />
        <Interview q="这里的 resume 和 A06 的 interrupt() 是什么关系？">
          <p>暂停点仍是 LangGraph 的 interrupt，所以必须有 checkpointer，并且用同一个 <kbd>thread_id</kbd> 恢复。Deep Agents 把「哪个工具要等人」收成 <kbd>interrupt_on</kbd>。这次中断的 <kbd>allowed_decisions</kbd> 是 approve、edit、reject、respond。A06 里则是你自己在节点里调用 <kbd>interrupt()</kbd>，<kbd>Command(resume=)</kbd> 的值原样回到那个调用。</p>
        </Interview>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .chapter-link { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  p.cue { margin: 18px 0 0; padding-left: 13px; border-left: 2px solid var(--teal);
    font-size: 14.5px; color: var(--graphite); }
  p.cue .t { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.4px;
    color: var(--teal); margin-right: 8px; }

  table.cmp { width: 100%; border-collapse: collapse; margin: 14px 0 4px; font-size: 14px;
    display: block; overflow-x: auto; }
  table.cmp th, table.cmp td { text-align: left; padding: 9px 12px;
    border-bottom: 1px solid var(--line); vertical-align: top; }
  table.cmp th { font-family: var(--font-mono); font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.4px; color: var(--muted); white-space: nowrap; }
  table.cmp td { color: var(--graphite); }
  table.cmp td:first-child { color: var(--ink); white-space: nowrap; }
  table.cmp tbody tr:last-child td { border-bottom: none; }
</style>
