---
import type { Section } from '../data/topics';
import { categoryConfig } from '../data/topics';
import { withBase } from '../lib/url';

interface Props {
  chapterCn: string;
  chapterEn: string;
  currentSlug: string;
  sections?: Section[];
}
const { chapterCn, chapterEn, currentSlug, sections = [] } = Astro.props;
---
<aside>
  <nav class="nav">
    <a class="home-link" href={withBase('/')}>← 返回主页 Home</a>

    <div class="nav-group">
      <span class="eyebrow">{chapterCn} / {chapterEn}</span>
      {sections.map((s, i) => (
        <a href={`#${s.id}`} class={i === 0 ? 'active' : ''} data-nav={s.id}>
          <span class="idx">{s.num}</span>{s.label}
          {s.lc && <span class="lc">{s.lc}</span>}
        </a>
      ))}
    </div>

    {categoryConfig.map((g) => (
      <div class="nav-group">
        <span class="eyebrow">{g.label.cn} / {g.label.en}</span>
        {g.chapters.map((c) => (
          c.ready ? (
            <a href={withBase(`${g.routePrefix}/${c.slug}`)} class={c.slug === currentSlug ? 'chapter-cur' : ''}>
              <span class="idx">{c.num}</span>{c.cn}
            </a>
          ) : (
            <a class="soon"><span class="idx">{c.num}</span>{c.cn}</a>
          )
        ))}
      </div>
    ))}
  </nav>
</aside>

<script>
  // 滚动高亮当前小节
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('aside .nav a[data-nav]'),
  );
  const entries = links.flatMap((link) => {
    const section = document.getElementById(link.dataset.nav!);
    return section ? [{ link, section }] : [];
  });
  const stickyHeader = document.querySelector<HTMLElement>('header.top');

  if (entries.length) {
    let activeIndex = entries.findIndex(({ link }) => link.classList.contains('active'));
    let frame: number | null = null;

    const setActive = (nextIndex: number) => {
      if (nextIndex === activeIndex) return;
      entries.forEach(({ link }, index) => {
        link.classList.toggle('active', index === nextIndex);
      });
      activeIndex = nextIndex;
    };

    const updateActive = () => {
      frame = null;
      const viewportBottom = window.scrollY + window.innerHeight;
      const documentBottom = document.documentElement.scrollHeight;
      if (
        documentBottom > window.innerHeight + 1
        && viewportBottom >= documentBottom - 1
      ) {
        setActive(entries.length - 1);
        return;
      }

      // 与 section.article 的 scroll-margin-top 配合，避开 sticky header。
      const activationLine = (stickyHeader?.getBoundingClientRect().bottom ?? 0) + 24;
      let nextIndex = 0;
      for (let index = 0; index < entries.length; index += 1) {
        if (entries[index].section.getBoundingClientRect().top > activationLine) break;
        nextIndex = index;
      }
      setActive(nextIndex);
    };

    const scheduleUpdate = () => {
      if (frame === null) frame = window.requestAnimationFrame(updateActive);
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    scheduleUpdate();
  }
</script>
