---
interface Props {
  kind?: 'base' | 'easy' | 'mid' | 'hard';
  text: string;
  href?: string;
}
const { kind = 'base', text, href } = Astro.props;
const cls = ['lc-badge', kind];
---
{href ? (
  <a class:list={cls} href={href} target="_blank" rel="noopener noreferrer" title="打开原题描述">{text}</a>
) : (
  <span class:list={cls}>{text}</span>
)}
