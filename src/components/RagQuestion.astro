---
interface Props {
  num: number;
  title: string;
}

const { num, title } = Astro.props;
---
<article class="rag-question">
  <div class="question-head">
    <span>Q{num}</span>
    <h4>{title}</h4>
  </div>
  <div class="answer"><slot /></div>
</article>

<style>
  .rag-question {
    margin: 18px 0;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .question-head { display: flex; align-items: flex-start; gap: 12px; }
  .question-head span {
    flex: none; margin-top: 2px; padding: 3px 8px; border-radius: 6px;
    color: var(--accent); background: var(--accent-wash);
    font: 700 11px var(--font-mono);
  }
  .question-head h4 {
    margin: 0; color: var(--ink); font: 600 16px/1.55 var(--font-display);
  }
  .answer { margin-top: 10px; color: var(--graphite); font-size: 14.5px; line-height: 1.75; }
  .answer :global(p) { margin: 8px 0; }
  .answer :global(ul), .answer :global(ol) { margin: 8px 0; padding-left: 22px; }
  .answer :global(li) { margin: 5px 0; }
  .answer :global(b) { color: var(--accent-ink); }
  .answer :global(table) {
    width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 13px;
  }
  .answer :global(th), .answer :global(td) {
    border: 1px solid var(--line); padding: 7px 9px; text-align: left; vertical-align: top;
  }
  .answer :global(th) { background: var(--accent-wash); color: var(--ink); font-weight: 600; }
  .answer :global(.exam) {
    margin: 0 0 10px; padding: 8px 12px; border-radius: 8px;
    background: var(--paper); color: var(--graphite); font-size: 13.5px;
  }
</style>
