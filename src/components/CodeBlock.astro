---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: string;
  file?: string;
  /** GitHub 源文件链接；传了就把文件名变成可跳转的源码链接 */
  src?: string;
}
const { code, lang = 'python', file, src } = Astro.props;
---
<figure class="code-figure">
  <div class="code-bar">
    {file &&
      (src ? (
        <a class="fn src-link" href={src} target="_blank" rel="noopener noreferrer" title="在 GitHub 查看源码">
          {file}<span class="ext">↗</span>
        </a>
      ) : (
        <span class="fn">{file}</span>
      ))}
    <span class="lang">{lang.toUpperCase()}</span>
  </div>
  <Code code={code.trim()} lang={lang as any} theme="github-dark-dimmed" />
</figure>
