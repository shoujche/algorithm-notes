---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import type { Category } from '../data/topics';

interface Props {
  title: string;
  description?: string;
  active?: Category;
}
const { title, description = '算法、Python 与 Agent 学习手记 — 图解数据结构与算法，深入 Python 工程与 Agent 系统', active } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/+/g, '/')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;450;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <SiteHeader active={active} />
  <slot />
  <footer>
    <span>算法、Python 与 Agent 学习手记</span>
    <span class="mono">Algorithms · Python · Agent · Built with Astro</span>
  </footer>
</body>
</html>
