# build output
dist/
.output/

# dependencies
node_modules/
__pycache__/
*.py[cod]
src/code/agent/react-agent-loop/.venv/

# astro
.astro/

# ReAct Agent runtime state
# The default workspace directory itself is tracked (via .gitkeep) so the
# documented commands find an existing mount source after a fresh checkout;
# everything the agent writes into it stays out of the repository.
src/code/agent/react-agent-loop/.runs/
src/code/agent/react-agent-loop/workspace/*
!src/code/agent/react-agent-loop/workspace/.gitkeep

# env
.env
.env.production

# macOS / editor
.DS_Store
.vscode/
*.log
